{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voltaic",
  "version": "0.1.0",
  "identifier": "dev.voltaic.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voltaic",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "A desktop video encoder for FFmpeg",
    "longDescription": "Voltaic is a desktop GUI for encoding video with FFmpeg: configure encoders, filters, HDR metadata, audio/subtitle tracks, and a job queue, backed by an FFmpeg install you already have (or point Voltaic at) rather than one bundled inside the app — see notes/plan.md M14 for why.",
    "copyright": "Copyright © 2026 the Voltaic contributors",
    "homepage": "https://github.com/delfianto/orange-loaf",
    "linux": {
      "deb": {
        "section": "video",
        "recommends": ["ffmpeg"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
